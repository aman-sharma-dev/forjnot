{
	"name": "backend",
	"version": "0.0.1",
	"description": "",
	"author": "",
	"private": true,
	"license": "UNLICENSED",
	"scripts": {
		"dev": "ts-node-dev --respawn --project tsconfig.build.json --require tsconfig-paths/register src/main.ts",
		"build": "nest build",
		"start": "node dist/main.js",
		"test": "jest --config=test/jest.config.ts",
		"test:watch": "jest --watch",
		"test:cov": "jest --coverage"
	},
	"dependencies": {
		"@nestjs/common": "^11.2.3",
		"@nestjs/core": "^11.2.3",
		"@nestjs/platform-express": "^11.2.3",
		"@nestjs/swagger": "^11.4.7",
		"@nestjs/terminus": "^11.1.1",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.2",
		"swagger-ui-express": "^5.0.1"
	},
	"devDependencies": {
		"@forjnot/shared-env": "workspace:*",
		"@nestjs/cli": "^11.0.24",
		"@nestjs/schematics": "^11.1.0",
		"@nestjs/testing": "^11.2.3",
		"@swc/cli": "^0.6.0",
		"@swc/core": "^1.16.1",
		"@types/express": "^5.0.6",
		"@types/jest": "^29.5.14",
		"@types/node": "^22.20.1",
		"@types/supertest": "^6.0.3",
		"jest": "^29.7.0",
		"source-map-support": "^0.5.21",
		"supertest": "^7.2.2",
		"ts-jest": "^29.4.12",
		"ts-loader": "^9.6.2",
		"ts-node": "^10.9.2",
		"ts-node-dev": "^2.0.0",
		"tsconfig-paths": "^4.2.0",
		"typescript": "^5.9.3"
	},
	"jest": {
		"moduleFileExtensions": ["js", "json", "ts"],
		"rootDir": "src",
		"testRegex": ".*\\.spec\\.ts$",
		"transform": {
			"^.+\\.(t|j)s$": "ts-jest"
		},
		"collectCoverageFrom": ["**/*.(t|j)s"],
		"coverageDirectory": "../coverage",
		"testEnvironment": "node"
	}
}
