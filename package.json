{
	"name": "forjnot",
	"version": "1.0.0",
	"packageManager": "pnpm@8.15.5",
	"description": "A high-performance monorepo starter template with NestJS, Next.js, and TurboRepo for scalable full-stack applications",
	"main": "index.js",
	"scripts": {
		"server": "pnpm --filter backend dev",
		"client": "pnpm --filter frontend dev",
		"build:all": "turbo run build",
		"dev": "turbo run dev",
		"lint": "biome lint .",
		"format": "biome format . --write",
		"test": "turbo run test",
		"prepare": "husky",
		"generate:module": "node ./.scripts/generate-module.cli.mjs",
		"cli:help": "node ./.scripts/base.cli.mjs",
		"doctor": "node ./.scripts/doctor.mjs",
		"check": "pnpm lint && pnpm test && pnpm build:all"
	},
	"lint-staged": {
		"**/*.{ts,tsx,js,jsx,json,css,md}": [
			"biome format --write",
			"biome lint",
			"git add"
		],
		"!packages/**/*": [],
		"!apps/backend/dist/**/*": [],
		"!apps/frontend/out/**/*": []
	},
	"keywords": [
		"monorepo",
		"nestjs",
		"nextjs",
		"turborepo",
		"typescript",
		"fullstack",
		"template",
		"starter",
		"pnpm",
		"microservices"
	],
	"author": "",
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^22.20.1",
		"husky": "^9.1.7",
		"lint-staged": "^15.5.2",
		"tsconfig-paths": "^4.2.0",
		"turbo": "^2.10.12",
		"typescript": "^5.9.3"
	},
	"dependencies": {
		"@biomejs/biome": "^1.9.4",
		"chalk": "^5.6.2",
		"commander": "^14.0.0",
		"dotenv": "^16.6.1",
		"fs-extra": "^11.4.0",
		"gradient-string": "^3.0.0",
		"inquirer": "^12.11.1",
		"rimraf": "^6.1.3",
		"zod": "^3.25.76"
	}
}
