# Runtime Configuration
RUNTIME_MODE=local

# Server Ports
PORT_BACKEND=8080
PORT_FRONTEND=3000

# Backend URLs
BACKEND_URL_LOCAL=http://localhost:8080
BACKEND_URL_DEVELOPMENT=https://development-server.com
BACKEND_URL_PRODUCTION=https://production-server.com

# Frontend URLs
FRONTEND_URL_LOCAL=http://localhost:3000
FRONTEND_URL_DEVELOPMENT=https://development-client.com
FRONTEND_URL_PRODUCTION=https://production-client.com

# Database Configuration (Optional)
# POSTGRES_URL=postgresql://user:password@localhost:5432/dbname
# MONGO_URL=mongodb://localhost:27017
# MONGO_DB_NAME=your_db_name

# Security (Required - Generate secure random strings)
SERVER_SECRET=your-secret-key-here-change-in-production
ENCRYPTION_KEY=your-encryption-key-here-change-in-production

# Logging
LOG_LEVEL=debug
